{
  "name": "pstack",
  "private": true,
  "version": "0.9.149",
  "description": "potluck is an agent workflow system built on Lauren Tan's pstack and Michael Denyer's multi-harness port. Rigorous agent workflows you can parallelize with confidence. Pi and OpenCode package of the Claude Code plugin; skills are shared, and runtime mappings translate tool names. Original pstack by Lauren Tan (poteto).",
  "author": {
    "name": "Thomas-Melonesoda",
    "url": "https://github.com/Thomas-Melonesoda"
  },
  "homepage": "https://github.com/Thomas-Melonesoda/potluck",
  "repository": "https://github.com/Thomas-Melonesoda/potluck",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pstack",
    "poteto-mode",
    "workflow",
    "principles",
    "agent-style",
    "subagents",
    "unslop",
    "claude-code",
    "skills",
    "tdd",
    "code-review",
    "parallel-agents",
    "codex",
    "opencode",
    "gemini-cli",
    "prime-agent"
  ],
  "pi": {
    "skills": [
      "./plugins/pstack/skills"
    ],
    "extensions": [
      "./plugins/pstack/pi/index.ts"
    ]
  },
  "exports": {
    "./server": "./plugins/pstack/opencode/index.js"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
